{
  "name": "filo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cross-env DEV_LOGIN=1 tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "express": "^4.22.3",
    "google-auth-library": "^9.15.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
