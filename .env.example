# Copia este archivo como .env (cp .env.example .env) y ajusta lo que necesites.

# ID de cliente OAuth de Google para "Continuar con Google".
# No es secreto: viaja dentro de la app. El "secreto del cliente" nunca va aquí (Filo no lo usa).
GOOGLE_CLIENT_ID=737709322971-ar8hss6michrgbkjkua3aik4u6gnu3nl.apps.googleusercontent.com

# Zona horaria del negocio.
BUSINESS_TZ=America/Panama

# Solo desarrollo: muestra "Entrar de prueba". Nunca en producción.
# DEV_LOGIN=1

# Cobro de la cuenta de barbero: test (pago simulado, no cobra) u off (gratis).
# Por defecto: test al desarrollar, off en producción.
# BILLING_PROVIDER=test
